# Copy this file to tools/cloud_config.env and fill the cloud API values.
# The real cloud_config.env is ignored by Git.

# Use "baidu" for cloud STT or "local" to keep faster-whisper recognition.
STT_PROVIDER=baidu
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
BAIDU_TOKEN_URL=https://aip.baidubce.com/oauth/2.0/token
BAIDU_SPEECH_URL=https://vop.baidu.com/server_api
BAIDU_CUID=eink-display
BAIDU_DEV_PID=1537
BAIDU_TIMEOUT=20

# Set ENABLE_DEEPSEEK=false to test Baidu STT alone.
ENABLE_DEEPSEEK=true
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=30
